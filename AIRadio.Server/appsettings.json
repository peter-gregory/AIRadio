{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.CallerInfo"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "AIRadio.Server.Services.Radio": "Debug",
        "AIRadio.Server.Services.Audio": "Debug",
        "Radio.Audio.Mpv": "Debug",
        "Radio.AI.ConversationLlamaClient": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext",
      {
        "Name": "WithCallerInfo",
        "Args": {
          "includeFileInfo": true,
          "assemblyPrefix": "AIRadio.",
          "startingAssembly": "AIRadio.Server"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} (at {ClassName}.{Method}:{LineNumber}){NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/opt/radio/airadio/airadio.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} (at {ClassName}.{Method}:{LineNumber}){NewLine}{Exception}"
        }
      }
    ]
  },
  "Application": {
    "DataDirectory": "/home/radio/.radio/data",
    "SoundsDirectory": "Data/Sounds",
    "PromptsDirectory": "Data/Prompts",
    "ConfigDirectory": "/home/radio/.radio/config"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "SpeechIntents": {
    "WakeUp": {
      "Name": "WakeUp",
      "Intent": "WakeUp",
      "Priority": 1000,
      "Expression": "^\\s*(?:hey|okay|ok|hello|a)\\s+(?:there\\s+)?radio\\b"
    },
    "BargeInStop": {
      "Name": "BargeInStop",
      "Intent": "BargeIn",
      "Priority": 900,
      "Expression": "^\\s*(?:stop|cancel|abort)\\s*[.!?]*\\s*$"
    },
    "BargeInNeverMind": {
      "Name": "BargeInNeverMind",
      "Intent": "BargeIn",
      "Priority": 900,
      "Expression": "^\\s*never\\s+mind\\s*[.!?]*\\s*$"
    },
    "BargeInRadioStop": {
      "Name": "BargeInRadioStop",
      "Intent": "BargeIn",
      "Priority": 900,
      "Expression": "^\\s*(?:hey\\s+)?radio\\s+stop\\s*[.!?]*\\s*$"
    }
  },
  "Llama": {
    "Endpoint": "http://localhost:5100/v1/chat/completions",
    "Model": "smollm2"
  },
  "Mpv": {
    "Transport": {
      "SocketPath": "/run/user/1000/mpv.sock",
      "SendTimeoutMilliseconds": 5000,
      "ReceiveBufferSize": 8192,
      "DuckVolume": 20
    }
  },
  "AudioFormat": {
    "SampleRate": 16000,
    "Channels": 1,
    "BitsPerSample": 16,
    "FrameMilliseconds": 20,
    "QueueFrames": 32,
    "DefaultVolume": 60
  },
  "Piper": {
    "Endpoint": "http://localhost:5200/generate",
    "Voice": "en_GB-northern_english_male-medium",
    "CacheSizeMB": 50,
    "CacheDirectory": "/home/radio/.radio/data/tts-cache"
  },
  "RadioBrowser": {
    "BaseUrl": "https://de1.api.radio-browser.info",
    "SearchPath": "/json/stations/search",
    "UserAgent": "RadioAppliance/1.0",
    "DefaultLimit": 25,
    "MaxLimit": 100
  },
  "News": {
    "Feeds": [
      {
        "Name": "NPR Top News",
        "Url": "https://feeds.npr.org/1001/rss.xml"
      }
    ]
  },
  "Weather": {
    "BaseUrl": "https://api.open-meteo.com/v1/forecast",
    "TemperatureUnit": "fahrenheit",
    "WindSpeedUnit": "mph",
    "PrecipitationUnit": "inch"
  },
  "AllowedHosts": "*"
}
