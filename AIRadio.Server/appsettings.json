{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Radio.Audio": "Debug",
      "Radio.Audio.Mpv": "Debug"
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Radio.Audio.Mpv": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/radio/radio.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Application": {
    "DataDirectory": "/home/radio/.radio/data",
    "SoundsDirectory": "Data/Sounds",
    "PromptsDirectory": "Data/Prompts",
    "ConfigDirectory": "/home/radio/.radio/config"
  },
  "AlarmManager": {
    "DataFile": "/var/lib/radio/scheduled-events.json"
  },
  "Llama": {
    "Endpoint": "http://localhost:8080/v1/chat/completions",
    "Model": "smollm2"
  },
  "Mpv": {
    "Transport": {
      "SocketPath": "/tmp/mpv.sock",
      "SendTimeoutMilliseconds": 5000,
      "ReceiveBufferSize": 8192,
      "DuckVolume": 20
    }
  },
  "AudioFormat": {
    "SampleRate": 22050,
    "Channels": 1,
    "BitsPerSample": 16,
    "FrameMilliseconds": 20,
    "QueueFrames": 200,
    "DefaultVolume": 60
  },
  "Piper": {
    "Endpoint": "http://localhost:5000",
    "Voice": "en_US-lessac-medium",
    "CacheSizeMB": 50,
    "CacheExpirationMinutes": 60
  },
  "RadioBrowser": {
    "BaseUrl": "https://de1.api.radio-browser.info",
    "SearchPath": "/json/stations/search",
    "UserAgent": "RadioAppliance/1.0",
    "DefaultLimit": 25,
    "MaxLimit": 100
  },
  "News": {
    "Feeds": [
      {
        "Name": "Top News",
        "Url": "https://example.com/news.xml",
        "Categories": [
          "top",
          "general"
        ]
      },
      {
        "Name": "Technology",
        "Url": "https://example.com/technology.xml",
        "Categories": [
          "technology"
        ]
      }
    ]
  },
  "AllowedHosts": "*"
}
