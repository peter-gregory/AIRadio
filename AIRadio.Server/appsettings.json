{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Radio.Audio": "Debug",
      "Radio.Audio.Mpv": "Debug",
      "Radio.AI.ConversationLlamaClient": "Debug"
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Radio.Audio.Mpv": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/opt/radio/airadio/airadio.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Application": {
    "DataDirectory": "/home/radio/.radio/data",
    "SoundsDirectory": "Data/Sounds",
    "PromptsDirectory": "Data/Prompts",
    "ConfigDirectory": "/home/radio/.radio/config"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Llama": {
    "Endpoint": "http://localhost:5100/v1/chat/completions",
    "Model": "smollm2"
  },
  "Mpv": {
    "Transport": {
      "SocketPath": "/run/user/1000/mpv.sock",
      "SendTimeoutMilliseconds": 5000,
      "ReceiveBufferSize": 8192,
      "DuckVolume": 20
    }
  },
  "AudioFormat": {
    "SampleRate": 22050,
    "Channels": 1,
    "BitsPerSample": 16,
    "FrameMilliseconds": 20,
    "QueueFrames": 32,
    "DefaultVolume": 60
  },
  "Piper": {
    "Endpoint": "http://localhost:5200/generate",
    "Voice": "en_GB-northern_english_male-medium",
    "CacheSizeMB": 50,
    "CacheDirectory": "/home/radio/.radio/data/tts-cache"
  },
  "RadioBrowser": {
    "BaseUrl": "https://de1.api.radio-browser.info",
    "SearchPath": "/json/stations/search",
    "UserAgent": "RadioAppliance/1.0",
    "DefaultLimit": 25,
    "MaxLimit": 100
  },
  "News": {
    "Feeds": [
      {
        "Name": "NPR Top News",
        "Url": "https://feeds.npr.org/1001/rss.xml",
        "Categories": ["top", "general"]
      },
      {
        "Name": "NPR World News",
        "Url": "https://feeds.npr.org/1004/rss.xml",
        "Categories": ["world", "international"]
      },
      {
        "Name": "NPR Business",
        "Url": "https://feeds.npr.org/1006/rss.xml",
        "Categories": ["business", "economy"]
      },
      {
        "Name": "NPR Science",
        "Url": "https://feeds.npr.org/1007/rss.xml",
        "Categories": ["science"]
      },
      {
        "Name": "NPR Technology",
        "Url": "https://feeds.npr.org/1019/rss.xml",
        "Categories": ["technology"]
      }
    ]
  },
  "AllowedHosts": "*"
}
