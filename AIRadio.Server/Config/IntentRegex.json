{
  "SpeechIntents": [
    {
      "Name": "WakeUp",
      "Intent": "WakeUp",
      "Priority": 1000,
      "Expression": "^\\s*(?:hey|okay|ok)\\s+(?:there\\s+)?radio\\b"
    },
    {
      "Name": "BargeInStop",
      "Intent": "BargeIn",
      "Priority": 900,
      "Expression": "^\\s*(?:stop|cancel|abort)\\s*[.!?]*\\s*$"
    },
    {
      "Name": "BargeInNeverMind",
      "Intent": "BargeIn",
      "Priority": 900,
      "Expression": "^\\s*never\\s+mind\\s*[.!?]*\\s*$"
    },
    {
      "Name": "BargeInRadioStop",
      "Intent": "BargeIn",
      "Priority": 900,
      "Expression": "^\\s*(?:hey\\s+)?radio\\s+stop\\s*[.!?]*\\s*$"
    }
  ]
}
