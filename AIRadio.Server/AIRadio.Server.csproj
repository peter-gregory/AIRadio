<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\airadio.client</SpaRoot>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:55593</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\airadio.client\airadio.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Enrichers.CallerInfo" Version="1.0.6" />
    <PackageReference Include="Serilog.Enrichers.CallStack" Version="1.0.358" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Config\IntentActions.json" />
    <Content Remove="native\tts-daemon\data\en_GB-northern_english_male-medium.onnx.json" />
    <None Include="Config\IntentRegex.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Config\StaticEvents.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64' and Exists('$(MSBuildProjectDirectory)/native/linux-arm64/libairadio-pipewire.so')">
    <None Include="native/linux-arm64/libairadio-pipewire.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Config\IntentActions.json" />
    <None Include="native\tts-daemon\data\en_GB-northern_english_male-medium.onnx.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="libairadio-pipewire.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Visual Studio publishes to its PubTmp staging directory. Copy Angular
       directly to the final ARM64 publish directory after the publish completes. -->
  <Target Name="CopyAngularToFinalPublishDirectory" AfterTargets="Publish">

    <ItemGroup>
      <AngularDistFiles Include="$(MSBuildProjectDirectory)\..\airadio.client\dist\airadio.client\browser\**\*" />
    </ItemGroup>

    <PropertyGroup>
      <AngularFinalPublishDir>$(MSBuildProjectDirectory)\bin\Release\net10.0\linux-arm64\</AngularFinalPublishDir>
    </PropertyGroup>

    <Message Importance="High" Text="AIRADIO ANGULAR PUBLISH TARGET: PublishDir=$(PublishDir)" />
    <Message Importance="High" Text="AIRADIO ANGULAR PUBLISH TARGET: FinalPublishDir=$(AngularFinalPublishDir)" />
    <Message Importance="High" Text="AIRADIO ANGULAR PUBLISH TARGET: Source=$(MSBuildProjectDirectory)\..\airadio.client\dist\airadio.client\browser" />
    <Message Importance="High" Text="AIRADIO ANGULAR PUBLISH TARGET: Files found=@(AngularDistFiles)" />

    <MakeDir Directories="$(AngularFinalPublishDir)wwwroot" />

    <Copy SourceFiles="@(AngularDistFiles)" DestinationFiles="@(AngularDistFiles->'$(AngularFinalPublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
